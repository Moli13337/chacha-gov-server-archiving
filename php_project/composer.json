{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.2.0",
        "doctrine/dbal": "^2.9",
        "fideloper/proxy": "~3.3",
        "firebase/php-jwt": "^5.0",
        "guzzlehttp/guzzle": "^6.3",
        "khanamiryan/qrcode-detector-decoder": "^1.0",
        "laravel/framework": "5.5.*",
        "laravel/tinker": "~1.0",
        "maatwebsite/excel": "^3.1",
        "mews/captcha": "^2.2",
        "phpoffice/phpspreadsheet": "^1.7",
        "predis/predis": "^0.8.7",
        "prettus/l5-repository": "^2.6",
        "spatie/laravel-activitylog": "3.2.2",
        "tencentcloud/tencentcloud-sdk-php": "^3.0",
        "tencentyoutuyun/php-sdk": "^1.0",
        "xkd/business-license-transform": "^0.0.2",
        "xkd/filterword": "^0.0.1",
        "xkd/location": "^0.0.2",
        "xkd/pdf": "^0.0.1",
        "xkd/sms": "^0.0.4",
        "xkd/upload": "^0.1.0",
        "xkd/utils": "^0.0.7",
        "zhuzhichao/ip-location-zh": "^2.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.6",
        "filp/whoops": "~2.0",
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "~1.0",
        "phpunit/phpunit": "~6.0",
        "symfony/thanks": "^1.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
             "app/Common/Function.php",
             "app/Common/Constant.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.hi-coffice.com/"
        },{
            "packagist": false
        }

	]
}
